# Copie para .env.local (desenvolvimento) e preencha. Na Vercel, cadastre as mesmas
# variáveis em Project Settings → Environment Variables. Nunca commite valores reais.
# Supabase: Dashboard → Project Settings → API Keys / Data API.

# --- Públicas (vão para o navegador; a proteção dos dados é o RLS) ---
# Lidas no BUILD: depois de alterá-las na Vercel, faça um novo deploy.

# URL do projeto Supabase (https://<ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) ou a anon key legada. NUNCA a secret/service_role:
# a aplicação recusa iniciar se uma chave secreta for colocada aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- SOMENTE SERVIDOR (sem prefixo NEXT_PUBLIC_) ---

# Secret key (sb_secret_...). Ignora o RLS: usada só para convidar/desativar usuários
# no Auth (lib/supabase/admin.ts), depois de confirmar que quem pede é ADMIN.
# A senha do banco nunca vai para a aplicação.
SUPABASE_SECRET_KEY=

# Opcional. Endereço público do site, sem barra no final (ex.: https://www.dominio.com.br).
# Usado nas URLs canônicas/Open Graph, no sitemap/robots e nos links de convite e
# recuperação de senha enviados por e-mail. Sem ela: na Vercel usa o domínio de produção
# do projeto; localmente, o endereço da requisição.
SITE_URL=
